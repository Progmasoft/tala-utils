---
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 8
ContinuationIndentWidth: 8
TabWidth: 8
UseTab: Never
ColumnLimit: 100

BreakAfterReturnType: All
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterStruct: true
  AfterUnion: true
  AfterEnum: true
  AfterCaseLabel: true
  AfterControlStatement: Always
  BeforeElse: false
  BeforeWhile: false
  AfterExternBlock: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false

AllowShortFunctionsOnASingleLine: Empty
AllowShortBlocksOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
SpaceInEmptyBraces: Always

SpaceBeforeParens: Never
SpacesInParens: Never
SpacesInSquareBrackets: true
SpaceBeforeSquareBrackets: false
SpaceAfterCStyleCast: true
SpaceBeforeAssignmentOperators: true
SpaceBeforeCaseColon: false
BitFieldColonSpacing: Both
PointerAlignment: Left
DerivePointerAlignment: false

AlignAfterOpenBracket: true
AlignOperands: DontAlign
BreakBeforeBinaryOperators: All
BreakAfterOpenBracketFunction: false
BreakBeforeCloseBracketFunction: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
PackArguments:
  BinPack: OnePerLine
PackParameters:
  BinPack: OnePerLine
PenaltyBreakAssignment: 100

AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
  AlignCompound: true
  PadOperators: false
  EnumAssignments: true
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
  AlignFunctionDeclarations: false
AlignConsecutiveBitFields: Consecutive
AlignConsecutiveMacros: Consecutive
AlignEscapedNewlines: Left

IndentCaseLabels: false
IndentCaseBlocks: false
IndentGotoLabels: NoIndent
IndentPPDirectives: AfterHash
PPIndentWidth: 4

Cpp11BracedListStyle: Block
BracedInitializerIndentWidth: 8
EnumTrailingComma: Insert

NumericLiteralCase:
  ExponentLetter: Lower
  HexDigit: Upper
  Prefix: Lower
  Suffix: Upper

SortIncludes:
  Enabled: true
  IgnoreCase: false
IncludeBlocks: Regroup
IncludeIsMainRegex: '$^'
IncludeCategories:
  - Regex: '^<(assert|complex|ctype|errno|fenv|float|inttypes|iso646|limits|locale|math|setjmp|signal|stdalign|stdarg|stdatomic|stdbool|stddef|stdint|stdio|stdlib|stdnoreturn|string|tgmath|threads|time|uchar|wchar|wctype)\.h>$'
    Priority: 1
  - Regex: '^<'
    Priority: 2
  - Regex: '^"'
    Priority: 3

MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtStartOfBlock: false
  AtStartOfFile: false
  AtEndOfFile: false
ReflowComments: false
...
